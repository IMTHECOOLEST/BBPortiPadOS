     return 1;
 }
 int bb_shared_memory(const char *name, uint64_t size) {
+#ifdef BB_IOS
+    /* shm_open is denied in the iOS sandbox: an unlinked file in the app's temporary folder is
+     * the shared memory object (MAP_SHARED of its descriptor behaves the same). */
+    const char *dir=getenv("TMPDIR");
+    char path[1024];
+    for (unsigned attempt=0; attempt<16; ++attempt) {
+        snprintf(path,sizeof(path),"%s/%.20s-%d-%u",dir && *dir ? dir : "/tmp",name,(int)getpid(),attempt);
+        int fd=open(path,O_RDWR|O_CREAT|O_EXCL,0600);
+        if (fd<0) { if (errno==EEXIST) continue; return -1; }
+        unlink(path);
+        fcntl(fd,F_SETFD,FD_CLOEXEC);
+        if (ftruncate(fd,(off_t)size)) { close(fd); return -1; }
+        return fd;
+    }
+    return -1;
+#else
     char path[64];
     for (unsigned attempt=0; attempt<16; ++attempt) {
         snprintf(path,sizeof(path),"/%.20s-%d-%u",name,(int)getpid(),attempt);
@@ -178,6 +205,7 @@
         return fd;
     }
     return -1;
+#endif
 }
